// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  ACTIVE
  INACTIVE
  BLOCKED
  PENDING
  DELETED
}

model Company {
  id     String @id @default(uuid())
  name   String
  email  String @unique
  apiKey String @unique

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  resumes           Resume[]
  selectionProcesses SelectionProcess[]
  jobOpenings       JobOpening[]
}

model Resume {
  id           String  @id @default(uuid())
  fileName     String
  fullName     String?
  email        String?
  confidence   Float?
  processingMs Int?
  costBrl      Float?
  dataJson     Json?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdById String?
  createdBy   User?   @relation("CreatedByUser", fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  selectionProcessEntries SelectionProcessCandidate[]
  selectedInProcesses     SelectionProcess[] @relation("SelectionProcessSelectedCandidate")
}

model Role {
  id   String @id @default(uuid())
  name String @unique // admin | mod | recruiter

  users User[]
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  status Status @default(ACTIVE)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdResumes Resume[] @relation("CreatedByUser")

  auditLogsPerformed AuditLog[] @relation("PerformedBy")

  createdSelectionProcesses SelectionProcess[] @relation("SelectionProcessCreatedBy")

  createdJobOpenings JobOpening[] @relation("JobOpeningCreatedBy")
}

enum SelectionProcessStatus {
  OPEN
  CLOSED
  CANCELLED
  CONCLUDED
}

model SelectionProcess {
  id     String                  @id @default(uuid())
  name   String
  status SelectionProcessStatus  @default(OPEN)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdById String?
  createdBy   User?   @relation("SelectionProcessCreatedBy", fields: [createdById], references: [id])

  jobOpeningId String?
  jobOpening   JobOpening? @relation(fields: [jobOpeningId], references: [id])

  selectedResumeId String?
  selectedResume   Resume? @relation("SelectionProcessSelectedCandidate", fields: [selectedResumeId], references: [id])

  closedAt    DateTime?
  cancelledAt DateTime?
  concludedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidates SelectionProcessCandidate[]
}

enum WorkModel {
  REMOTE
  HYBRID
  ONSITE
}

enum ContractType {
  CLT
  PJ
  INTERNSHIP
  TEMPORARY
}

enum JobOpeningStatus {
  OPEN
  CLOSED
}

model JobOpening {
  id            String           @id @default(uuid())
  title         String
  workModel     WorkModel
  contractType  ContractType
  salaryRange   String?
  requirements  String[]
  differentials String[]
  status        JobOpeningStatus @default(OPEN)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdById String?
  createdBy   User?   @relation("JobOpeningCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  selectionProcesses SelectionProcess[]
}

model SelectionProcessCandidate {
  id String @id @default(uuid())

  selectionProcessId String
  selectionProcess   SelectionProcess @relation(fields: [selectionProcessId], references: [id])

  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id])

  addedAt DateTime @default(now())

  @@unique([selectionProcessId, resumeId])
}

model AuditLog {
  id String @id @default(uuid())

  entityType String
  entityId   String

  action String

  oldValue String?
  newValue String?

  performedByUserId String
  performedBy       User   @relation("PerformedBy", fields: [performedByUserId], references: [id])

  performedByName String

  createdAt DateTime @default(now())
}
